<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Accessibility service — requires user to explicitly enable in Settings -->
        <service
            android:name="dev.a10101100.snipcraft.core.accessibility.SnipAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Foreground companion service — keeps accessibility service alive on OEM killers -->
        <service
            android:name="dev.a10101100.snipcraft.core.accessibility.SnipForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Required for Play Store review; describes the specialUse subtype -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="accessibility-companion" />
        </service>

    </application>

</manifest>
